{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-hysteria-realm",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "vars": {
    "MAX_REALMS": "65536",
    "MAX_REALMS_PER_IP": "4",
    "TRUSTED_PROXY_HEADER": "CF-Connecting-IP",
    "DEBUG": "false"
  },
  "secrets": {
    "required": ["REALM_TOKEN", "ABLY_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-hysteria-realm",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
