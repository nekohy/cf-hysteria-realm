{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-hysteria-realm",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "vars": {
    "DEBUG": "false"
  },
  "secrets": {
    "required": ["REALM_TOKEN", "ABLY_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-hysteria-realm",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
